# Gemini

# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=put-your-gemini-api-key-here
# LLM_MODEL=gemini-3.8-flash
# LLM_TEMPERATURE=0.2



# Get a free key: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1/


# COMPOSE_PROFILES=local and LOCAL_LLM_ENABLED=true if u needna use ollama
COMPOSE_PROFILES=
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b

SPRING_PROFILES_ACTIVE=dev

GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

DEEP_ANALYSIS_MAX_LAWS_TOTAL=40
DEEP_ANALYSIS_MAX_ARTICLES_TOTAL=100
DEEP_ANALYSIS_MAX_CONFLICTS=20
DEEP_ANALYSIS_PRIMARY_LAWS=15
DEEP_ANALYSIS_ARTICLES_PER_LAW=10
